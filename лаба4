from Bio.PDB import PDBParser
from Bio.PDB.Polypeptide import PPBuilder

def extract_phi_psi(pdb_filename):
    parser = PDBParser(QUIET=True)
    struct = parser.get_structure("MODEL", pdb_filename)
    builder = PPBuilder()
    
    phi_psi = []
    for pp in builder.build_peptides(struct):
        for res, angles in zip(pp, pp.get_phi_psi_list()):
            phi, psi = angles
            # Перевіряємо кути і виключаємо гліцин (GLY)
            if phi is not None and psi is not None and res.get_resname() != 'GLY':
                phi_psi.append((
                    res.get_resname(),
                    round(phi * 57.296, 1),
                    round(psi * 57.296, 1)
                ))
                
    print(f"Файл {pdb_filename}: знайдено {len(phi_psi)} залишків (без урахування гліцину).")
    return phi_psi

