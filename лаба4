import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
import numpy as np
from Bio.PDB import PDBParser
from Bio.PDB.Polypeptide import PPBuilder

# 1. Функция для извлечения углов (без гліцину)
def extract_phi_psi(pdb_filename):
    parser = PDBParser(QUIET=True)
    struct = parser.get_structure("MODEL", pdb_filename)
    builder = PPBuilder()
    
    phi_psi = []
    for pp in builder.build_peptides(struct):
        for res, angles in zip(pp, pp.get_phi_psi_list()):
            phi, psi = angles
            if phi is not None and psi is not None and res.get_resname() != 'GLY':
                phi_psi.append((
                    res.get_resname(),
                    round(phi * 57.296, 1),
                    round(psi * 57.296, 1)
                ))
    return phi_psi

# 2. Функция для построения карты Рамачандрана
def plot_ramachandran(phi_psi_list, title, filename):
    phi = [x[1] for x in phi_psi_list]
    psi = [x[2] for x in phi_psi_list]
    
    fig, ax = plt.subplots(figsize=(6, 6))
    
    # Характерні області (згідно з методичкою)
    ax.add_patch(plt.Rectangle((-160, -60), 100, 70,
        color="lightblue", alpha=0.4, label="α-спіраль (φ≈-60°, ψ≈-50°"))
    ax.add_patch(plt.Rectangle((-160, 90), 120, 80,
        color="lightgreen", alpha=0.4, label="β-лист (φ≈-90…-60°, ψ≈120…180°)"))
    
    ax.scatter(phi, psi, s=20, color="black", zorder=5)
    
    ax.set_xlim(-180, 180)
    ax.set_ylim(-180, 180)
    ax.set_xlabel("φ (°)", fontsize=12)
    ax.set_ylabel("ψ (°)", fontsize=12)
    ax.set_title(title, fontsize=13)
    ax.axhline(0, color="gray", linewidth=0.5)
    ax.axvline(0, color="gray", linewidth=0.5)
    ax.legend(fontsize=9, loc="upper right")
    
    plt.tight_layout()
    plt.savefig(filename, dpi=150)
    plt.show()
    print(f"Збережено графік: {filename}")

