import time
from Bio import Entrez, SeqIO
import matplotlib.pyplot as plt
import numpy as np
import RNA

Entrez.email = "your_email@gmail.com"
taxonomy_id = "2697049"

time.sleep(1 / 10)
handle = Entrez.efetch(
    db="nucleotide", id="NC_045512.2", rettype="gb", retmode="text"
)
record = SeqIO.read(handle, "genbank")
handle.close()

seq = str(record.seq).upper()

min_length = 100
max_length = 1000
STOP_CODONS = {"TAA", "TAG", "TGA"}
orfs = []

for frame in range(3):
  i = frame
  while i < len(seq) - 2:
    if seq[i : i + 3] == "ATG":
      start = i
      j = i + 3
      while j < len(seq) - 2:
        codon = seq[j : j + 3]
        if codon in STOP_CODONS:
          break
        j += 3
      if j < len(seq) - 2 and seq[j : j + 3] in STOP_CODONS:
        length_aa = (j - start) // 3
        if max_length >= length_aa >= min_length:
          orfs.append({
              "frame": frame + 1,
              "start": start + 1,
              "end": j + 3,
              "length_aa": length_aa,
          })
      i += 3
    else:
      i += 3

for orfs_print in orfs:
  print(orfs_print)

for feature in record.features:
  if feature.type == "CDS":
    name = feature.qualifiers.get("gene", ["?"])[0]
    start = int(feature.location.start)
    end = int(feature.location.end)
    cds_seq = record.seq[start:end]
    print(f"{name}: {start}–{end}, {len(cds_seq)} нт")

target_start = int(record.features[5].location.start)
target_end = int(record.features[5].location.end)
seq_fold = seq[target_start : target_end + 1]

md = RNA.md()
md.temperature = 0.0
md.gquad = 1
fc = RNA.fold_compound(seq_fold, md)
ss, mfe = fc.mfe()
print(mfe)
print(ss)

temperatures = np.linspace(0, 100, 51)
mfe_values = []
melted_at = None

for T in temperatures:
  md.temperature = T
  fc = RNA.fold_compound(seq_fold, md)
  ss_t, mfe_t = fc.mfe()
  mfe_values.append(mfe_t)
  if "(" not in ss_t and ")" not in ss_t and melted_at is None:
    melted_at = T

plt.figure(figsize=(8, 5))
plt.plot(
    temperatures,
    mfe_values,
    marker="o",
    color="crimson",
    linewidth=2,
    label="MFE",
)
plt.axvline(x=37, color="navy", linestyle="--", label="37°C")
if melted_at is not None:
  plt.axvline(
      x=melted_at, color="darkgreen", linestyle="--", label=f"Tm ({melted_at}°C)"
  )

plt.title("Залежність енергії від температури", fontsize=11)
plt.xlabel("Температура (°C)", fontsize=10)
plt.ylabel("MFE (ккал/моль)", fontsize=10)
plt.grid(True, linestyle=":", alpha=0.6)
plt.legend()
plt.savefig("rna_melting_curve.png")
plt.show()
