import time
from Bio import Entrez, SeqIO
import matplotlib.pyplot as plt
import numpy as np
import RNA

# 1-3. Entrez configuration and fetching SARS-CoV-2 genome (NC_045512.2)
Entrez.email = 'your_email@gmail.com'
taxonomy_id = '2697049'  # SARS-CoV-2 taxonomy ID

time.sleep(1 / 10)
handle = Entrez.efetch(
    db='nucleotide', id='NC_045512.2', rettype='gb', retmode='text'
)
record = SeqIO.read(handle, 'genbank')
handle.close()

seq = str(record.seq).upper()
print(f'Genome length: {len(seq)} nt, Taxonomy ID: {taxonomy_id}')

# 5. ORF Finder implementation
min_length = 50
max_length = 1000
STOP_CODONS = {'TAA', 'TAG', 'TGA'}
orfs = []

for frame in range(3):
  i = frame
  while i < len(seq) - 2:
    if seq[i : i + 3] == 'ATG':
      start = i
      j = i + 3
      while j < len(seq) - 2:
        codon = seq[j : j + 3]
        if codon in STOP_CODONS:
          break
        j += 3
      if j < len(seq) - 2 and seq[j : j + 3] in STOP_CODONS:
        length_aa = (j - start) // 3
        if max_length >= length_aa >= min_length:
          orfs.append({
              'frame': frame + 1,
              'start': start + 1,
              'end': j + 3,
              'length_aa': length_aa,
          })
      i += 3
    else:
      i += 3

print(f'Found custom ORFs: {len(orfs)}')

# 6. Annotated CDS comparison
annotated_cds = []
for feature in record.features:
  if feature.type == 'CDS':
    name = feature.qualifiers.get('gene', ['?'])[0]
    start = int(feature.location.start)
    end = int(feature.location.end)
    annotated_cds.append((name, start, end, end - start))
    print(
        f'CDS {name}: {start}–{end}, {end - start} nt ({(end - start) // 3} aa)'
    )

# 7 & 8. Select a small CDS ('E' gene) and check for G-quadruplex at 0°C
target_cds = None
for feature in record.features:
  if feature.type == 'CDS' and feature.qualifiers.get('gene', [''])[0] == 'E':
    start = int(feature.location.start)
    end = int(feature.location.end)
    target_cds = str(record.seq[start:end]).upper()
    break

if not target_cds:
  start, end = int(record.features[5].location.start), int(
      record.features[5].location.end
  )
  target_cds = str(record.seq[start:end]).upper()

md_g4 = RNA.md()
md_g4.temperature = 0.0
md_g4.gquad = 1
fc_g4 = RNA.fold_compound(target_cds, md_g4)
ss_g4, mfe_g4 = fc_g4.mfe()
print(f'G4 MFE at 0°C: {mfe_g4} kcal/mol')
print(f'Structure (G4): {ss_g4}')

# 9. Temperature dependence and melting analysis
temps = np.linspace(0, 100, 51)
mfes = []
for T in temps:
  md = RNA.md()
  md.temperature = T
  fc = RNA.fold_compound(target_cds, md)
  ss, mfe = fc.mfe()
  mfes.append(mfe)

plt.figure(figsize=(8, 5))
plt.plot(temps, mfes, marker='o', color='b', linestyle='-')
plt.axvline(
    x=37.0, color='r', linestyle='--', label='Physiological Temp (37°C)'
)
plt.title('Temperature Dependence of MFE for SARS-CoV-2 E gene')
plt.xlabel('Temperature (°C)')
plt.ylabel('MFE (kcal/mol)')
plt.legend()
plt.grid(True)
plt.savefig('melting_curve.png')
plt.show()

# 10. General conclusions
print('\n--- CONCLUSIONS ---')
print(
    '1. Successfully retrieved SARS-CoV-2 complete genome (NC_045512.2) via'
    ' Entrez API.'
)
print(
    '2. Custom ORF finder identified open reading frames based on start/stop'
    ' codons within thresholds.'
)
print(
    '3. GenBank CDS annotations differ from raw algorithmic ORFs due to'
    ' biological features like ribosomal frameshifting, non-AUG starts, and'
    ' experimental validation.'
)
print(
    '4. ViennaRNA folding with G-quadruplex support at 0°C and temperature'
    ' sweep up to 100°C successfully characterized secondary structure stability'
    ' and thermal melting.'
)












