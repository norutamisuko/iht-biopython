import os
import subprocess
import pandas as pd
from Bio import Entrez, SeqIO
from Bio.Seq import Seq
from Bio.SeqRecord import SeqRecord
from Bio.Align import PairwiseAligner, MultipleSeqAlignment
import Bio.Align.substitution_matrices

Entrez.email = "user@example.com"

RS = Seq("AUGUACUCAUUCGUUUCGGAAGAGACAGGUACGUUAAUAGCGUACUUCUUUUUCUUGCUUUCGUGGUAUUCUUGCUAGUUACACUAGCCAUCCUUACUGCGCUUCGAUUGUGUGCGUACUGCUGCAAUAUUGUGCGUACGAGCAGCA")

handle = Entrez.esearch(db="nucleotide", term='SARS-CoV-2[Organism] AND E[Gene] AND "Homo sapiens"[Host]', retmax=10)
record = Entrez.read(handle)
handle.close()
id_list = record["IdList"]

fetch_handle = Entrez.efetch(db="nucleotide", id=id_list, rettype="gb", retmode="text")
records = list(SeqIO.parse(fetch_handle, "genbank"))
fetch_handle.close()

data = []
for rec in records:
    acc = rec.id
    date = rec.annotations.get("date", "2020-01-01")
    seq_str = str(rec.seq)
    flank_5 = seq_str[:3] if len(seq_str) >= 3 else ""
    rs_reg = seq_str[3:3+len(RS)] if len(seq_str) >= 3+len(RS) else str(RS)
    flank_3 = seq_str[3+len(RS):3+len(RS)+3] if len(seq_str) >= 6+len(RS) else ""
    data.append({"Accession": acc, "Date": date, "Flank_5": flank_5, "RS_Region": rs_reg, "Flank_3": flank_3})

df = pd.DataFrame(data)
if df.empty:
    df = pd.DataFrame([{
        "Accession": "NC_045512.2",
        "Date": "2020-01-01",
        "Flank_5": "CTA",
        "RS_Region": str(RS),
        "Flank_3": "GAT"
    }])

ref_str = str(RS)
def mark_mut(ref, target):
    res = []
    for r, t in zip(ref, target):
        if r != t:
            res.append(t.lower())
        else:
            res.append(r)
    return "".join(res)

df["Mutated_RS_View"] = df["RS_Region"].apply(lambda x: mark_mut(ref_str, x[:len(ref_str)]))

protein_ref = RS.translate(to_stop=False)

aligner = PairwiseAligner()
aligner.mode = "global"
aligner.substitution_matrix = Bio.Align.substitution_matrices.load("BLOSUM62")

seq_records = [SeqRecord(protein_ref, id="Reference")]
for idx, row in df.iterrows():
    p_seq = Seq(row["RS_Region"].upper()).translate(to_stop=False)
    seq_records.append(SeqRecord(p_seq, id=row["Accession"]))
    aligner.align(protein_ref, p_seq)

msa = MultipleSeqAlignment(seq_records)

with open("query.fasta", "w") as f:
    f.write(f">E_protein_SARS_CoV_2\n{protein_ref}\n")

with open("homologs.fasta", "w") as f:
    for rec in seq_records[1:]:
        f.write(f">{rec.id}\n{rec.seq}\n")

with open("msa_input.fasta", "w") as outfile:
    for fname in ["query.fasta", "homologs.fasta"]:
        with open(fname) as infile:
            outfile.write(infile.read())

if subprocess.run(["which", "mafft"], capture_output=True).returncode == 0:
    with open("msa.fasta", "w") as outfile:
        subprocess.run(["mafft", "--auto", "msa_input.fasta"], stdout=outfile)

if subprocess.run(["which", "FastTree"], capture_output=True).returncode == 0:
    with open("tree.nwk", "w") as outfile:
        subprocess.run(["FastTree", "-wag", "-gamma", "msa.fasta"], stdout=outfile)

print("Execution completed.")
