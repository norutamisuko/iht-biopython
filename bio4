import time
from Bio import Entrez, SeqIO
import matplotlib.pyplot as plt
import RNA

print('Іванова Роксана Сергіївна 2 курс КНУТШ ІВТ ОП "Хімія біомолекул"')
Entrez.email = 'aboba.com'
time.sleep(0.1)

handle = Entrez.efetch(
    db='nucleotide', id='NC_045512.2', rettype='gb', retmode='text'
)
record = SeqIO.read(handle, 'genbank')
handle.close()
seq = str(record.seq).upper()

min_len, max_len, orfs = 100, 1000, []
for f in range(3):
  i = f
  while i < len(seq) - 2:
    if seq[i : i + 3] == 'ATG':
      start, j = i, i + 3
      while j < len(seq) - 2 and seq[j : j + 3] not in {'TAA', 'TAG', 'TGA'}:
        j += 3
      if j < len(seq) - 2:
        L = (j - start) // 3
        if min_len <= L <= max_len:
          orfs.append(
              {'frame': f + 1, 'start': start + 1, 'end': j + 3, 'length_aa': L}
          )
      i = j + 3
    else:
      i += 3

for feat in record.features:
  if feat.type == 'CDS':
    print(
        f"CDS {feat.qualifiers.get('gene', ['?'])[0]}:"
        f" {int(feat.location.start)}–{int(feat.location.end)}"
    )

e_seq = next(
    str(seq[int(f.location.start) : int(f.location.end)])
    for f in record.features
    if f.type == 'CDS' and f.qualifiers.get('gene', ['?'])[0] == 'E'
)

RNA.cvar.temperature = 0.0
ss, mfe = RNA.fold(e_seq)
print(f'MFE (0°C): {mfe}, SS: {ss}')

temps, mfes = range(0, 120, 5), []
for T in temps:
  RNA.cvar.temperature = float(T)
  mfes.append(RNA.fold(e_seq)[1])

plt.figure(figsize=(7, 4))
plt.plot(list(temps), mfes, marker='o', color='crimson')
plt.title('MFE vs Temperature (Gene E)')
plt.xlabel('Temperature (°C)')
plt.ylabel('MFE (kcal/mol)')
plt.grid(True)
plt.savefig('rna_melting_curve.png')
print('Графік збережено у "rna_melting_curve.png"')
